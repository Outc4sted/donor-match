{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["DMNO_PARENT_SERVER"],
  "globalEnv": ["APP_ENV"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "lint": {
      "outputs": [".eslintcache"]
    },
    "check-types": {},
    "env:docker": {
      "outputs": [".dmno/.env.docker"]
    }
  }
}
