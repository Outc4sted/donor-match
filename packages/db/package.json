{
  "name": "@repo/db",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    "./prisma/*": {
      "types": "./dist/prisma/generated/prisma-client/*.d.ts",
      "default": "./dist/prisma/generated/prisma-client/*.js"
    },
    "./prisma/errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./zenstack/*": {
      "types": "./dist/prisma/generated/logical-prisma-client/*.d.ts",
      "default": "./dist/prisma/generated/logical-prisma-client/*.js"
    },
    "./zenstack/enhance": {
      "types": "./dist/prisma/generated/enhance.d.ts",
      "default": "./dist/prisma/generated/enhance.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "dev": "nodemon --watch src/models --ext zmodel --exec \"pnpm run schema:gen && pnpm run schema:push\" --on-change-only",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check-types": "tsc --noEmit --incremental",
    "schema:gen": "zenstack generate --schema ./src/schema.zmodel -o ./src/prisma/generated",
    "schema:push": "dmno run -- prisma db push --schema=./src/prisma/schema.prisma",
    "env:docker": "dmno resolve --service @repo/db --format env > .dmno/.env.docker",
    "lint": "eslint --fix --cache --max-warnings 0",
    "seed": "dmno run -- prisma db seed",
    "build": "tsc"
  },
  "prisma": {
    "seed": "tsx src/seeds/index.ts"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "sh -c 'pnpm --filter=@repo/db run check-types'",
      "pnpm --filter=@repo/db run lint"
    ],
    "**/*.{mjs,ts,tsx,json,md,mdx}": [
      "pnpm -w run prettier"
    ]
  },
  "dependencies": {
    "@prisma/client": "*",
    "@zenstackhq/runtime": "*",
    "dmno": "*"
  },
  "devDependencies": {
    "@faker-js/faker": "*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "*",
    "eslint": "*",
    "nodemon": "*",
    "prisma": "*",
    "tsx": "*",
    "typescript": "latest",
    "zenstack": "*"
  }
}
