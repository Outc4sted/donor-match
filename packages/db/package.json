{
  "name": "@repo/db",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    "./prisma/*": "./src/prisma/generated/prisma-client/*.ts",
    "./prisma/errors": "./src/errors/index.ts",
    "./zenstack/*": "./src/prisma/generated/logical-prisma-client/*.ts",
    "./zenstack/enhance": "./src/prisma/generated/enhance.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "nodemon --watch src/models --ext zmodel --exec \"pnpm run schema:gen && pnpm run schema:push\" --on-change-only",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check-types": "tsc --noEmit",
    "schema:gen": "zenstack generate --schema ./src/schema.zmodel -o ./src/prisma/generated",
    "schema:push": "dmno run -- prisma db push --schema=./src/prisma/schema.prisma",
    "env:docker": "dmno resolve --service @repo/db --format env > .dmno/.env.docker",
    "lint": "eslint . --fix --cache --max-warnings 0",
    "seed": "dmno run -- prisma db seed",
    "build": "tsc"
  },
  "prisma": {
    "seed": "tsx src/seeds/index.ts"
  },
  "dependencies": {
    "@prisma/client": "*",
    "@zenstackhq/runtime": "*",
    "dmno": "*"
  },
  "devDependencies": {
    "@faker-js/faker": "*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "*",
    "eslint": "*",
    "nodemon": "*",
    "prisma": "*",
    "tsx": "*",
    "typescript": "latest",
    "zenstack": "*"
  }
}
