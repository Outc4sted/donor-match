{
  "name": "@repo/ts-rest",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "./schemas/organs/*": {
      "types": "./src/schemas/organs/*.ts",
      "default": "./dist/schemas/organs/*.js"
    },
    "./schemas/patients/*": {
      "types": "./src/schemas/patients/*.ts",
      "default": "./dist/schemas/patients/*.js"
    }
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
    "check-types": "tsc --noEmit",
    "lint": "eslint --fix --cache --max-warnings 0",
    "build": "tsc"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "pnpm --filter=@repo/ts-rest run lint"
    ],
    "**/*.{js,ts,tsx,json,md}": [
      "pnpm -w run prettier"
    ]
  },
  "dependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/db": "workspace:*",
    "eslint": "*",
    "@ts-rest/core": "3.53.0-rc.1",
    "zod": "*",
    "nodemon": "*",
    "typescript": "latest"
  }
}
