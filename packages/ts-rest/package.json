{
  "name": "@repo/ts-rest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./schemas/organs/*": {
      "types": "./dist/schemas/organs/*.d.ts",
      "default": "./dist/schemas/organs/*.js"
    },
    "./schemas/patients/*": {
      "types": "./dist/schemas/patients/*.d.ts",
      "default": "./dist/schemas/patients/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit --incremental",
    "dev": "tsc -w -p tsconfig.build.json",
    "lint": "eslint --fix --cache --max-warnings 0"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "sh -c 'pnpm --filter=@repo/ts-rest run check-types'",
      "pnpm --filter=@repo/ts-rest run lint"
    ],
    "**/*.{mjs,ts,tsx,json,md,mdx}": [
      "pnpm -w run prettier"
    ]
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@ts-rest/core": "catalog:tsrest",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
