{
  "name": "@repo/store",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    "./*": {
      "types": "./dist/stores/*/index.d.ts",
      "default": "./dist/stores/*/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "dev": "tsc -w -p tsconfig.build.json",
    "check-types": "tsc --noEmit --incremental",
    "lint": "eslint --fix --cache --max-warnings 0",
    "build": "tsc -p tsconfig.build.json"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "sh -c 'pnpm --filter=@repo/store run check-types'",
      "pnpm --filter=@repo/store run lint"
    ],
    "**/*.{mjs,ts,tsx,json,md,mdx}": [
      "pnpm -w run prettier"
    ]
  },
  "dependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/ts-rest": "workspace:*",
    "@ts-rest/core": "3.53.0-rc.1",
    "eslint": "*",
    "nodemon": "*",
    "typescript": "latest"
  }
}
