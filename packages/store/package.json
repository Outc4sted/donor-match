{
  "name": "@repo/store",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    "./organStore": {
      "types": "./src/stores/organStore/index.ts",
      "default": "./dist/stores/organStore/index.js"
    },
    "./patientStore": {
      "types": "./src/stores/patientStore/index.ts",
      "default": "./dist/stores/patientStore/index.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
    "check-types": "tsc --noEmit",
    "lint": "eslint --fix --cache --max-warnings 0",
    "build": "tsc"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "pnpm --filter=@repo/store run lint"
    ],
    "**/*.{js,ts,tsx,json,md}": [
      "pnpm -w run prettier"
    ]
  },
  "dependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/ts-rest": "workspace:*",
    "@ts-rest/core": "3.53.0-rc.1",
    "eslint": "*",
    "nodemon": "*",
    "typescript": "latest"
  }
}
