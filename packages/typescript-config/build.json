{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Build",
  "compilerOptions": {
    "tsBuildInfoFile": "${configDir}/dist/tsconfig.build.tsbuildinfo",
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/src",
    "noEmit": false
  },
  "include": ["${configDir}/src"]
}
