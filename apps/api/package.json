{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit --incremental",
    "dev": "dmno run -- tsx --watch src/server.ts",
    "env:docker": "dmno resolve --service api --format env > .dmno/.env.docker",
    "lint": "eslint --fix --cache --max-warnings 0",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "sh -c 'pnpm --filter=api run check-types'",
      "pnpm --filter=api run lint"
    ],
    "**/*.{mjs,ts,tsx,json,md,mdx}": [
      "pnpm -w run prettier"
    ]
  },
  "dependencies": {
    "@clerk/backend": "*",
    "@dmno/fastify-integration": "*",
    "@fastify/cookie": "*",
    "@fastify/jwt": "*",
    "@fastify/request-context": "*",
    "@fastify/swagger": "*",
    "@fastify/swagger-ui": "*",
    "@repo/db": "workspace:*",
    "@repo/store": "workspace:*",
    "@repo/ts-rest": "workspace:*",
    "@ts-rest/core": "3.53.0-rc.1",
    "@ts-rest/fastify": "3.53.0-rc.1",
    "@ts-rest/open-api": "3.53.0-rc.1",
    "dmno": "*",
    "fastify": "*",
    "fastify-plugin": "*",
    "qs": "*"
  },
  "devDependencies": {
    "@clerk/types": "*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/qs": "*",
    "eslint": "*",
    "pino-pretty": "*",
    "tsx": "*",
    "typescript": "latest"
  }
}
