{
  "name": "@repo/docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "dmno run -- astro",
    "build": "dmno run -- astro build",
    "check-types": "tsc --noEmit --incremental",
    "dev": "dmno run -- astro dev",
    "lint": "eslint --fix --cache --max-warnings 0",
    "preview": "dmno run -- astro preview",
    "start": "dmno run -- astro dev"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "sh -c 'pnpm --filter=@repo/docs run check-types'",
      "pnpm --filter=@repo/docs run lint"
    ],
    "**/*.{mjs,ts,tsx,json,md,mdx}": [
      "pnpm -w run prettier"
    ],
    "**/*.{md,mdx}": [
      "pnpm -w run lint:md"
    ]
  },
  "prettier": "@repo/prettier",
  "dependencies": {
    "@astrojs/starlight": "catalog:astro",
    "@astrojs/starlight-tailwind": "catalog:astro",
    "@dmno/astro-integration": "catalog:dmno",
    "@tailwindcss/vite": "*",
    "astro": "catalog:astro",
    "dmno": "catalog:dmno",
    "sharp": "*",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint": "workspace:*",
    "@repo/prettier": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:"
  }
}
