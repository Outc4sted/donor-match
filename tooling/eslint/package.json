{
  "name": "@repo/eslint",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./utils": {
      "types": "./types.d.ts",
      "default": "./utils.mjs"
    },
    "./base": {
      "types": "./types.d.ts",
      "default": "./base.mjs"
    },
    "./astro": {
      "types": "./types.d.ts",
      "default": "./astro.mjs"
    },
    "./react": {
      "types": "./types.d.ts",
      "default": "./react.mjs"
    },
    "./playwright": {
      "types": "./types.d.ts",
      "default": "./playwright.mjs"
    },
    "./storybook": {
      "types": "./types.d.ts",
      "default": "./storybook.mjs"
    }
  },
  "lint-staged": {
    "**/*.{mjs,json,md,mdx}": [
      "pnpm -w run prettier"
    ],
    "**/*.{md,mdx}": [
      "pnpm -w run lint:md"
    ]
  },
  "prettier": "@repo/prettier",
  "devDependencies": {
    "@eslint/compat": "*",
    "@eslint/eslintrc": "*",
    "@eslint/js": "*",
    "@repo/prettier": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "astro-eslint-parser": "*",
    "eslint": "catalog:",
    "eslint-config-prettier": "*",
    "eslint-config-turbo": "*",
    "eslint-config-xo": "*",
    "eslint-config-xo-react": "*",
    "eslint-plugin-astro": "*",
    "eslint-plugin-better-tailwindcss": "*",
    "eslint-plugin-jsx-a11y": "*",
    "eslint-plugin-playwright": "*",
    "eslint-plugin-prettier": "*",
    "eslint-plugin-react": "*",
    "eslint-plugin-react-hooks": "*",
    "eslint-plugin-regexp": "*",
    "eslint-plugin-storybook": "*",
    "globals": "*",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "*"
  }
}
